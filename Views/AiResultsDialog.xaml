<Window x:Class="MeetingNotes.Views.AiResultsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="About AI Results"
        Height="300" Width="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SidebarBackgroundBrush}"
        Icon="/MeetingNotes.ico">

    <StackPanel Margin="34,30,34,26">

        <!-- Heading -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18">
            <TextBlock Text="🤖" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBlock Text="About AI Results" Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="20" FontWeight="SemiBold" FontFamily="Segoe UI"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Divider -->
        <Rectangle Height="1" Fill="{DynamicResource SeparatorBrush}" Margin="0,0,0,20"/>

        <!-- Message -->
        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13.5" FontFamily="Segoe UI"
                   TextWrapping="Wrap" LineHeight="21" TextAlignment="Left"
                   Margin="0,0,0,24"
                   Text="Wrong or poor AI results? Check your prompt and model in Settings. This app doesn't control AI output — it only sends the transcript and displays the reply."/>

        <!-- Close button -->
        <Button Content="Got it" Style="{DynamicResource PrimaryButton}"
                Width="100" HorizontalAlignment="Center"
                Click="CloseButton_Click"/>

    </StackPanel>
</Window>
